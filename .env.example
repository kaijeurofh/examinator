# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# The agent reads PYDANTIC_AI_MODEL to decide which provider/model to talk to.
# Format: "provider:model-name" (see https://ai.pydantic.dev/models/).

#PYDANTIC_AI_MODEL=openai:gpt-5.2

# --- Provider API keys ------------------------------------------------------
# Only the key for the provider in PYDANTIC_AI_MODEL is required.

#OPENAI_API_KEY=sk-replace-me
#ANTHROPIC_API_KEY=sk-ant-replace-me
#GEMINI_API_KEY=replace-me

# --- Examinator web app -----------------------------------------------------
# Comma-separated list of origins the FastAPI app accepts CORS requests from.
# In local dev the Next.js frontend runs on port 3000.
#EXAMINATOR_CORS_ORIGINS=http://localhost:3000

# Optional regex passed to FastAPI's `allow_origin_regex`. Defaults to a
# permissive RFC1918 + loopback match so VPN / LAN clients hitting the
# frontend via a private IPv4 (http://192.168.x.y:3040) are accepted.
#   unset / empty       -> default LAN regex (covers VPN clients).
#   off/none/disabled   -> disable regex, only EXAMINATOR_CORS_ORIGINS counts.
#   <custom regex>      -> used verbatim; lock down to a specific subnet, e.g.
#     EXAMINATOR_CORS_ORIGIN_REGEX=^http://192\.168\.134\.\d{1,3}:3040$
#EXAMINATOR_CORS_ORIGIN_REGEX=

# Max accepted upload size for PDF study material (in megabytes).
#EXAMINATOR_MAX_PDF_MB=20

# Hard cap on the number of chunks we send to the LLM per job. Keeps cost and
# latency bounded for very large documents.
#EXAMINATOR_MAX_CHUNKS=8

# --- Local LLM via Ollama (branch: examinator-lokal) ------------------------
# Set to `ollama` to route the agent through a local Ollama daemon. With the
# default `openai` value the PYDANTIC_AI_MODEL / OPENAI_API_KEY pair above is
# used instead. docker-compose.yml on this branch pre-configures the variables
# below for you; uncomment/override only when running outside docker compose.
#EXAMINATOR_LLM_PROVIDER=ollama

# OpenAI-compatible endpoint of your Ollama install. From inside docker we
# need host.docker.internal; on bare metal use http://localhost:11434/v1.
#
# Port conflict note: if another docker-compose project on your machine
# already binds 11434 on 0.0.0.0, move *your* Ollama to a private port:
#   1. set the Windows user env var OLLAMA_HOST=0.0.0.0:11435
#   2. restart Ollama (Quit from tray, then re-launch)
#   3. uncomment the line below to point this stack at the new port.
#OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
#OLLAMA_BASE_URL=http://host.docker.internal:11435/v1

# Model tag as shown by `ollama list`. Must be pulled beforehand
# (`ollama pull gemma4:31b`). gemma4:31b needs ~22 GB VRAM — comfy on an
# RTX 5090; smaller cards should drop to a quantized 7B/14B variant.
# Other tags also work, including HuggingFace-hosted models pulled via
# `ollama pull hf.co/<org>/<repo>:<tag>` — useful for testing reasoning-
# distilled variants alongside the official Gemma/Qwen releases.
#OLLAMA_MODEL=gemma4:31b

# Structured-output strategy. Default on this branch is `tool` -- chosen
# empirically against a real Studienheft PDF (see scripts/benchmark_local.py
# and the README "Output-Modus"-Tabelle). Override here only if a benchmark
# on *your* corpus shows a different mode wins.
#   tool     -- pydantic-ai's default; native tool/function calling. Robust
#               for OpenAI/Anthropic/Gemini *and* Gemma 4 via Ollama: the
#               only mode that produced schema-valid candidates on Studienheft-
#               grade input in our A/B test.
#   prompted -- inline the JSON schema into the system prompt and parse the
#               JSON reply. Works for older local models without a tool-call
#               template (Gemma 2/3, smaller Llamas, Mistral 7B), but FAILS
#               on Gemma 4 in this stack because its chat template emits
#               reasoning tokens before the JSON, which our nested
#               PageQuestions[T] schema rejects.
#   native   -- pass the JSON schema via `response_format` (OpenAI-style
#               structured output). Experimental against Ollama's OpenAI-compat
#               endpoint (pydantic-ai issue #4917); validate with
#               `scripts/benchmark_local.py` before relying on it.
#EXAMINATOR_OUTPUT_MODE=tool
