# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# The agent reads PYDANTIC_AI_MODEL to decide which provider/model to talk to.
# Format: "provider:model-name" (see https://ai.pydantic.dev/models/).
#
# Pick a model your account actually has access to. As of mid-2026 the
# OpenAI catalogue exposes the following ids (see
# https://developers.openai.com/api/docs/models):
#   openai:gpt-5.5         - flagship, best reasoning/coding (recommended)
#   openai:gpt-5.4-mini    - cheaper / lower latency
#   openai:gpt-5.4-nano    - cheapest, good enough for simple extraction
#   openai:gpt-4o          - widely available all-rounder
# There is no rolling `-latest` alias for the 5.x line; use the bare id.
PYDANTIC_AI_MODEL=openai:gpt-5.5

# --- Provider API keys ------------------------------------------------------
# Only the key for the provider in PYDANTIC_AI_MODEL is required. REPLACE
# the placeholder below with your real key — otherwise the backend aborts
# the first job with "Missing credentials. Please pass an `api_key` ...".
OPENAI_API_KEY=sk-replace-me

# Optional alternatives. Uncomment + switch PYDANTIC_AI_MODEL accordingly
# (e.g. `anthropic:claude-4.6-sonnet-latest`, `google-gla:gemini-2.5-pro`).
#ANTHROPIC_API_KEY=sk-ant-replace-me
#GEMINI_API_KEY=replace-me

# --- Examinator web app -----------------------------------------------------
# Comma-separated list of origins the FastAPI app accepts CORS requests from.
# docker-compose.yml already injects a sensible default
# (http://localhost:${FRONTEND_PORT:-3030}); override only if you want to
# allow additional origins (e.g. a LAN IP).
#EXAMINATOR_CORS_ORIGINS=http://localhost:3030

# Max accepted upload size for PDF study material (in megabytes).
#EXAMINATOR_MAX_PDF_MB=20

# Hard cap on the number of chunks we send to the LLM per job. Keeps cost and
# latency bounded for very large documents.
#EXAMINATOR_MAX_CHUNKS=8

# Frontend host port. Backend port stays internal (frontend reverse-proxies
# `/api/*` to `http://backend:8000` over the docker network), so changing
# the frontend port does not require rebuilding the image.
#FRONTEND_PORT=3030
