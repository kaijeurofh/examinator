# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# The agent reads PYDANTIC_AI_MODEL to decide which provider/model to talk to.
# Format: "provider:model-name" (see https://ai.pydantic.dev/models/).

PYDANTIC_AI_MODEL=openai:gpt-5.2

# --- Provider API keys ------------------------------------------------------
# Only the key for the provider in PYDANTIC_AI_MODEL is required.

OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me
GEMINI_API_KEY=replace-me

# --- Examinator web app -----------------------------------------------------
# Comma-separated list of origins the FastAPI app accepts CORS requests from.
# In local dev the Next.js frontend runs on port 3000.
EXAMINATOR_CORS_ORIGINS=http://localhost:3000

# Max accepted upload size for PDF study material (in megabytes).
EXAMINATOR_MAX_PDF_MB=20

# Hard cap on the number of chunks we send to the LLM per job. Keeps cost and
# latency bounded for very large documents.
EXAMINATOR_MAX_CHUNKS=8

# --- Local LLM via Ollama (branch: examinator-lokal) ------------------------
# Set to `ollama` to route the agent through a local Ollama daemon. With the
# default `openai` value the PYDANTIC_AI_MODEL / OPENAI_API_KEY pair above is
# used instead. docker-compose.yml on this branch pre-configures the variables
# below for you; uncomment/override only when running outside docker compose.
#EXAMINATOR_LLM_PROVIDER=ollama

# OpenAI-compatible endpoint of your Ollama install. From inside docker we
# need host.docker.internal; on bare metal use http://localhost:11434/v1.
#OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Model tag as shown by `ollama list`. Must be pulled beforehand
# (`ollama pull gemma4:31b`). gemma4:31b needs ~22 GB VRAM — comfy on an
# RTX 5090; smaller cards should drop to a quantized 7B/14B variant.
#OLLAMA_MODEL=gemma4:31b

# Structured-output strategy:
#   tool     -- pydantic-ai's default; native tool/function calling. Use this
#               for OpenAI/Anthropic/Gemini.
#   prompted -- inline the JSON schema into the system prompt and parse the
#               JSON reply. More reliable for local models without solid
#               tool-calling support (Gemma family).
#EXAMINATOR_OUTPUT_MODE=prompted
